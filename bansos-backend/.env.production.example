# ==========================================================================
# Template environment PRODUKSI untuk alwaysdata
# Salin menjadi `.env` di server, lalu isi nilai yang bertanda <...>
# JANGAN commit file hasil salinan (.env sudah masuk .gitignore)
# ==========================================================================

APP_NAME="BansosHub"
APP_ENV=production
APP_DEBUG=false
# Buat dengan: php artisan key:generate --show
APP_KEY=
# Ganti dengan domain alwaysdata kamu, tanpa trailing slash
APP_URL=https://<username>.alwaysdata.net

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Logging: jangan `debug` di produksi, isinya bisa memuat data warga
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Database (dari panel alwaysdata → Databases → MySQL) ──────────────────
DB_CONNECTION=mysql
DB_HOST=<mysql-host>.alwaysdata.net
DB_PORT=3306
DB_DATABASE=<username>_bansos
DB_USERNAME=<username>
DB_PASSWORD=<password-database>

# ── Session & cache: pakai file, tidak butuh tabel tambahan ───────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log

# ── CORS: WAJIB diisi domain frontend, kalau tidak browser memblokir ──────
# Pisahkan dengan koma bila lebih dari satu (mis. domain Vercel + custom domain)
CORS_ALLOWED_ORIGINS=https://<proyek>.vercel.app

# ── Sanctum ───────────────────────────────────────────────────────────────
# Domain frontend (tanpa skema), dipakai untuk stateful domain
SANCTUM_STATEFUL_DOMAINS=<proyek>.vercel.app
# Masa berlaku token (menit). 1440 = 24 jam
SANCTUM_EXPIRATION=1440

# ==============================================================================
# Proyek Bansos (BansosHub — SPK SAW) Root Environment Reference
# ==============================================================================
#
# Proyek ini terbagi menjadi dua sub-direktori:
# 1. bansos-backend (Laravel 12 API) -> salin ke bansos-backend/.env
# 2. bansos-frontend (React 19 + Vite) -> salin ke bansos-frontend/.env
#
# ------------------------------------------------------------------------------
# Backend Environment Configuration (bansos-backend/.env)
# ------------------------------------------------------------------------------
APP_NAME=BansosHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=db_bansos_saw
# DB_USERNAME=root
# DB_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000,::1
SANCTUM_EXPIRATION=1440

# ------------------------------------------------------------------------------
# Frontend Environment Configuration (bansos-frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_URL=http://127.0.0.1:8000/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api
